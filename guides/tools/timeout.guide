SUMMARY=Bounds long du scans so inspect cannot hang forever.
APT=coreutils
DNF=coreutils
YUM=coreutils
PACMAN=coreutils
APK=coreutils
BREW=coreutils
HOW_APT=sudo apt update && sudo apt install -y coreutils
HOW_DNF=sudo dnf install -y coreutils
HOW_YUM=sudo yum install -y coreutils
HOW_PACMAN=sudo pacman -S --needed coreutils
HOW_APK=sudo apk add coreutils
HOW_BREW=brew install coreutils
NOTE=Optional but recommended; inspect falls back without it.
