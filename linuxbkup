#!/usr/bin/env bash
# linuxbkup — Bash-first Linux backup / restore CLI
set -Eeuo pipefail

LINUXBKUP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LINUXBKUP_ROOT

# shellcheck source=lib/core/common.sh
source "${LINUXBKUP_ROOT}/lib/core/common.sh"
# shellcheck source=lib/core/terminal/style.sh
source "${LINUXBKUP_ROOT}/lib/core/terminal/style.sh"
# shellcheck source=lib/core/help.sh
source "${LINUXBKUP_ROOT}/lib/core/help.sh"
# shellcheck source=lib/core/safety.sh
source "${LINUXBKUP_ROOT}/lib/core/safety.sh"
# shellcheck source=lib/core/cli_tips.sh
source "${LINUXBKUP_ROOT}/lib/core/cli_tips.sh"
# shellcheck source=lib/core/profile.sh
source "${LINUXBKUP_ROOT}/lib/core/profile.sh"
# shellcheck source=lib/constraints/list.sh
source "${LINUXBKUP_ROOT}/lib/constraints/list.sh"

_ui_init

linuxbkup_parse_globals "$@"
# Re-init after --no-color / --no-links may have been set
_ui_init

set -- "${LINUXBKUP_POSITIONAL[@]:-}"

cmd="${1:-}"
if [[ -n "${cmd}" ]]; then
  shift
fi

case "${cmd}" in
  ""|-h|--help)
    linuxbkup_usage
    exit 0
    ;;
  help)
    if [[ -n "${1:-}" ]]; then
      linuxbkup_cmd_help "$1" || exit 2
    else
      linuxbkup_usage
    fi
    exit 0
    ;;
  -V|--version|version)
    linuxbkup_print_version
    exit 0
    ;;
  inspect|backup|plan|restore|verify|list|deps)
    linuxbkup_install_traps
    # shellcheck source=/dev/null
    source "${LINUXBKUP_ROOT}/lib/cmd/${cmd}.sh"
    # Drop -e for command body: handled Ctrl+C leaves status 130; commands
    # already fatal/return on real errors.
    set +e
    "linuxbkup_cmd_${cmd}" "$@"
    _lb_rc=$?
    set -e
    declare -F linuxbkup_tty_restore >/dev/null 2>&1 && linuxbkup_tty_restore
    exit "${_lb_rc}"
    ;;
  *)
    log_fatal "Unknown command: ${cmd}"
    if [[ "${LINUXBKUP_TEST:-0}" -ne 1 ]]; then
      printf '\n' >&2
      linuxbkup_usage >&2
    fi
    exit 2
    ;;
esac
